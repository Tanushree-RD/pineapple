flowchart TD
    subgraph Clients["Clients & Interfaces"]
        CLI["CLI Commands (bin/kvdb)"]
        Serve["kvdb serve (Text / b64)"]
        Torture["HYDRA Torture Tool"]
    end

    subgraph Lock["Process Ownership"]
        FLock["path.lock (flock LOCK_EX | LOCK_NB)"]
    end

    subgraph API["Engine API (src/engine/api.go)"]
        EngineAPI["Open / Put / Get / Delete / Batch / ApplyStream / Compact / Check"]
    end

    subgraph WritePipeline["Write Pipeline (Single Committer)"]
        ReqChan["Request Channel"]
        Committer["Committer Goroutine"]
        W0["1. Admission (Append / Rewrite / ErrFull) [CP-W01]"]
        W1["2. Tail Repair (ftruncate / sentinel repair) [CP-W02]"]
        W2["3. Stream Frame (Header + Payload + CRC64 + Sentinel) [CP-W03]"]
        W3["4. fsync Data File [CP-W04 -> CP-W05]"]
        W4["5. Publish to Memory Index [CP-W06]"]
        W5["6. OnCommit Hook: Emit ACK [CP-W07]"]
    end

    subgraph Memory["In-Memory State"]
        Index["Index map[string]entry (off, len)"]
        RWMutex["Index RWMutex"]
        Stats["OpenStats & Live Accounting"]
    end

    subgraph DiskLayout["On-Disk File Layout (path)"]
        SBA["Superblock A (0..4095, 68B used)"]
        SBB["Superblock B (4096..8191, 68B used)"]
        Frames["Log Frames (8192..logical_end)"]
        KEYDIR["KEYDIR Checkpoint Frame"]
        TornTail["Torn Tail / Sentinel Gap (past logical_end)"]
    end

    subgraph RecoveryFlow["Recovery Algorithm (open)"]
        R0["Acquire path.lock & Clean Stale .tmp"]
        R1["Select Active Superblock (Highest Valid Generation) [CP-R01]"]
        R2["Validate Checkpoint Binding or Fallback to Full Scan [CP-R02]"]
        R3["Strict Frame Scan (Stop at First Invalid Byte) [CP-R03]"]
        R4["Rebuild Index & Set Tail State (Zero Bytes Written)"]
    end

    subgraph CompactionFlow["Compaction & Rewrite Flow"]
        C1["Open path.compact.tmp with New Epoch [CP-C01]"]
        C2["Stream Packed Frames (≤ 4 MiB) from Old File [CP-C02]"]
        C3["Append KEYDIR & fsync tmp [CP-C03]"]
        C4["Atomic rename(tmp, path) [CP-C04 -> CP-C05]"]
        C5["fsync Directory"]
        C6["Locked Swap of File Handle + Index + Epoch [CP-C06]"]
        C7["Close Old File Handle"]
    end

    %% Client flows
    CLI --> EngineAPI
    Serve --> EngineAPI
    Torture --> Serve

    %% Write ordering flow
    EngineAPI -->|Writes / Mutations| ReqChan
    ReqChan --> Committer
    Committer --> W0
    W0 --> W1
    W1 --> W2
    W2 --> W3
    W3 --> W4
    W4 --> W5
    W5 -->|Emit ACK| Serve

    %% Disk interactions
    W2 -->|pwrite| Frames
    W3 -->|fsync| DiskLayout
    W4 -->|Write Lock| Index

    %% Read interaction
    EngineAPI -->|Get / ForEach| RWMutex
    RWMutex -->|Read Lock| Index
    Index -->|pread offset| Frames

    %% Recovery links
    FLock --> R0
    R0 --> R1
    R1 --> SBA
    R1 --> SBB
    R1 --> R2
    R2 --> KEYDIR
    R2 --> R3
    R3 --> Frames
    R3 --> R4
    R4 --> Index

    %% Compaction links
    EngineAPI -->|Compact / Rewrite| C1
    C1 --> C2
    C2 --> C3
    C3 --> C4
    C4 --> C5
    C5 --> C6
    C6 --> Index
    C6 --> C7
